<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StopWatchActivity">

    <!-- 跑动小人层（位于控件下方） -->
    <com.hellozh.stopwatch.RunnersView
        android:id="@+id/runners_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 主内容容器 - 垂直LinearLayout居中显示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true"
        android:padding="16dp">

        <!-- 优化后的计时器显示 -->
        <TextView
            android:id="@+id/text_view_stopwatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="80sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:text="00:00.000"
            android:layout_marginBottom="30dp"
            android:maxLines="1"
            android:ellipsize="none"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="80sp"
            android:autoSizeStepGranularity="2sp"/>

        <!-- 按钮容器 - 水平排列 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/button_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start"
                android:layout_marginEnd="20dp"/>

            <Button
                android:id="@+id/button_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop"
                android:layout_marginEnd="20dp"/>

            <Button
                android:id="@+id/button_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"/>
        </LinearLayout>

        <!-- 反色与动态背景开关 - 并排 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_invert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invert Colors"
                android:layout_marginEnd="20dp"/>

            <Switch
                android:id="@+id/switch_runners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:checked="true"
                android:text="Runners  "/>
        </LinearLayout>


    </LinearLayout>

    <!-- 底部文字 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="powered by Camera HAL"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="20dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"/>

</RelativeLayout> 
